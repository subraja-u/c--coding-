
#include <stdio.h>

int reverse(int n, int rev)
{
    if (n == 0)
        return rev;

    return reverse(n / 10, rev * 10 + n % 10);
}

int main()
{
    int n, result;

    printf("Enter a positive integer: ");
    scanf("%d", &n);

    result = reverse(n, 0);

    printf("Reversed number = %d", result);

    return 0;
}
Output:
Enter a positive integer: 12345
Reversed number = 54321
