
#include <stdio.h>

int main()
{
    int a[100], b[100];
    int n, m, i, j, k;

    printf("Enter size of first array: ");
    scanf("%d", &n);

    printf("Enter first array elements: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter size of second array: ");
    scanf("%d", &m);

    printf("Enter second array elements: ");
    for (i = 0; i < m; i++)
        scanf("%d", &b[i]);

    printf("Intersection: ");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < m; j++)
        {
            if (a[i] == b[j])
            {
                for (k = 0; k < i; k++)
                {
                    if (a[k] == a[i])
                        break;
                }

                if (k == i)
                    printf("%d ", a[i]);

                break;
            }
        }
    }

    return 0;
}

Output:
Enter size of first array: 5
Enter first array elements: 1 2 3 4 5
Enter size of second array: 5
Enter second array elements: 3 4 5 6 7
Intersection: 3 4 5
